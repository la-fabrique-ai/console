{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    14
  ],
  "theme": "graphite",
  "font": "JetBrains Mono",
  "font_size": 13,
  "ui_font": "Geist",
  "background": "canvas",
  "colors": {
    "accent": "#C8CED6",
    "canvas": "#111316",
    "chrome": "#171A1F",
    "surface": "#1D2127",
    "border": "#272B31"
  },
  "terminal_padding": [
    8,
    8
  ],
  "gap": 0,
  "preview": "layouts/fabrique-console-v3-agent.svg",
  "children": [
    {
      "id": "fabrique-console-v3-bar",
      "type": "block",
      "content": {
        "mod": "fabrique-console-v3-bar",
        "props": {
          "page": "agent"
        }
      },
      "size": {
        "px": 216
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "column",
      "size": {
        "weight": 1
      },
      "children": [
        {
          "id": "top",
          "type": "block",
          "content": {
            "mod": "fabrique-console-v3-top",
            "props": {
              "page": "agent"
            }
          },
          "size": {
            "px": 78
          }
        },
        {
          "id": "agent-main",
          "type": "column",
          "size": {
            "weight": 1
          },
          "children": [
            {
              "id": "agent-head",
              "type": "block",
              "content": {
                "mod": "fabrique-console-v3-agent"
              },
              "size": {
                "px": 44
              }
            },
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              },
              "size": {
                "px": 38
              }
            },
            {
              "id": "terminal",
              "type": "block",
              "min": 180,
              "content": {
                "tab": "active",
                "pane": {
                  "lone": true,
                  "gap": 6,
                  "radius": 8,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 28,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
