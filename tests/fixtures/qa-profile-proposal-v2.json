                "test/unit/region-names.test.ts",
                "test/unit/partner-follower-filters.test.ts",
                "test/unit/user-display-name.test.ts",
                "--passWithNoTests=false"
              ],
              "timeoutMs": 600000,
              "terminal": true
            },
            "types": {
              "argv": [
                "pnpm",
                "exec",
                "tsc",
                "--noEmit"
              ],
              "timeoutMs": 300000,
              "terminal": true
            }
          }
        },
        {
          "key": "app",
          "path": "/example/repos/alpha/app",
          "tests": {
            "rapide": {
              "argv": [
