          }
        },
        {
          "key": "admin",
          "path": "/example/repos/alpha/admin",
          "tests": {
            "rapide": {
              "argv": [
                "pnpm",
                "exec",
                "vitest",
                "run",
                "test/unit/weather-contract-schema.test.ts",
                "test/unit/firestore-doc-id.test.ts",
                "--passWithNoTests=false"
              ],
              "timeoutMs": 120000,
              "terminal": true
